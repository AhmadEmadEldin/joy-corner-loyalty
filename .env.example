# Legacy rollback only: Firebase web app config embedded only in a legacy build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase browser configuration. The publishable/anon key is intentionally
# public; never put SUPABASE_SERVICE_ROLE_KEY in a VITE_* variable.
VITE_SUPABASE_URL=https://ruurfhrjqfcydxbzpuqi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_a4ySmRdu-RJoISB_kvjjgg_3iCha3z1
# Supabase is the operational frontend/backend. Use `legacy` only for an
# intentional rollback or backup-system exercise.
VITE_DATA_PROVIDER=supabase

# Server-side migration tools only. Never expose this value to the browser.
SUPABASE_PROJECT_REF=ruurfhrjqfcydxbzpuqi
SUPABASE_SERVICE_ROLE_KEY=
REPORTING_SYNC_BATCH_SIZE=25

# Supabase reporting worker. Configure one Google credential method; never put
# these values in browser-prefixed variables.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Reporting worker / legacy rollback Google Sheets access. Firebase Functions
# uses its default runtime service account for Google API auth.
GOOGLE_SHEET_ID=1e1z1pfNArVzaZs5FE4k0e3JqIlwJIPG_aWH4Fziqnl8
# Local-only compatibility: old local scripts may still use
# GOOGLE_SHEETS_SPREADSHEET_ID.

# Legacy rollback only: Firebase Admin access for local scripts. Deployed Firebase
# Functions use runtime credentials instead. Do not use FIREBASE_* env names in
# this project root because Firebase Functions reserves that prefix during deploy.
JOY_FIREBASE_PROJECT_ID=
JOY_FIREBASE_CLIENT_EMAIL=
JOY_FIREBASE_PRIVATE_KEY=
JOY_FIREBASE_SERVICE_ACCOUNT_JSON=
JOY_FIREBASE_SERVICE_ACCOUNT_KEY_FILE=

# Optional backend-only Canva voucher integration secrets. Leave blank unless
# Legacy voucher generation is connected from Firebase Functions.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REFRESH_TOKEN=

# Optional backend-only Neon PostgreSQL reporting/backup database.
# Keep this server-side only. Do not expose it through VITE_* variables.
NEON_DATABASE_URL=
NEON_BACKUP_ENABLED=false

# Local development only.
API_PORT=3001
FRONTEND_PORT=8081
