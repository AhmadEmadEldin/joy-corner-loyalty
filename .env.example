# Frontend (Vercel)
# Set to the Northflank production API URL for Vercel builds
VITE_API_URL=http://localhost:3001/api

# Backend (Northflank)
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8081
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOW_MIGRATED_ACCOUNT_CLAIM=false

# Database (Neon; server-side only)
NEON_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_SSL=true
MIGRATION_CONFIRM_STAGING=false

# Staff seed passwords (set at least one)
SEED_OWNER_PASSWORD=
SEED_CASHIER_PASSWORD=
SEED_WAITER_PASSWORD=
SEED_BARISTA_PASSWORD=

# Google Sheets reporting worker only
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
REPORTING_SYNC_BATCH_SIZE=50

# Product image object storage (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=joy-corner/staging/menu-items
