# Frontend Firebase web app config. These are embedded in the browser build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Google Sheets access. Keep these server-side only.
GOOGLE_SHEET_ID=1e1z1pfNArVzaZs5FE4k0e3JqIlwJIPG_aWH4Fziqnl8
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Compatibility only: old deploys may still use GOOGLE_SHEETS_SPREADSHEET_ID
# or GOOGLE_SERVICE_ACCOUNT_JSON. Prefer the clean keys above.

# Backend Firebase Admin access for local scripts only. Deployed Firebase
# Functions use runtime credentials instead. Do not use FIREBASE_* env names in
# this project root because Firebase Functions reserves that prefix during deploy.
JOY_FIREBASE_PROJECT_ID=
JOY_FIREBASE_CLIENT_EMAIL=
JOY_FIREBASE_PRIVATE_KEY=
JOY_FIREBASE_SERVICE_ACCOUNT_JSON=
JOY_FIREBASE_SERVICE_ACCOUNT_KEY_FILE=

# Optional backend-only Canva voucher integration secrets. Leave blank unless
# voucher generation is connected from Firebase Functions.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REFRESH_TOKEN=

# Local development only.
API_PORT=3001
FRONTEND_PORT=8081
