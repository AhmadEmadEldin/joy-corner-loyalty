# Frontend Firebase web app config. These are embedded in the browser build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Google Sheets access. Keep these server-side in Netlify only.
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Compatibility only: old deploys may still use GOOGLE_SHEETS_SPREADSHEET_ID
# or GOOGLE_SERVICE_ACCOUNT_JSON. Prefer the clean keys above.

# Backend Firebase Admin access. Keep these server-side in Netlify only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Compatibility only: old deploys may still use FIREBASE_SERVICE_ACCOUNT_JSON.
# Prefer the clean keys above.

# Local development only.
CANVA_BACKEND_PORT=3001
