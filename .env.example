# Frontend Firebase web app config. These are embedded in the browser build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Google Sheets access. Deployed Firebase Functions uses its default
# runtime service account for Google API auth, so production only needs this ID.
GOOGLE_SHEET_ID=1e1z1pfNArVzaZs5FE4k0e3JqIlwJIPG_aWH4Fziqnl8
# Local-only compatibility: old local scripts may still use
# GOOGLE_SHEETS_SPREADSHEET_ID.

# Backend Firebase Admin access for local scripts only. Deployed Firebase
# Functions use runtime credentials instead. Do not use FIREBASE_* env names in
# this project root because Firebase Functions reserves that prefix during deploy.
JOY_FIREBASE_PROJECT_ID=
JOY_FIREBASE_CLIENT_EMAIL=
JOY_FIREBASE_PRIVATE_KEY=
JOY_FIREBASE_SERVICE_ACCOUNT_JSON=
JOY_FIREBASE_SERVICE_ACCOUNT_KEY_FILE=

# Optional backend-only Neon PostgreSQL reporting/backup database.
# Keep this server-side only. Do not expose it through VITE_* variables.
NEON_DATABASE_URL=
NEON_BACKUP_ENABLED=false

# Local development only.
API_PORT=3001
FRONTEND_PORT=8081
