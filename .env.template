PORT=8081

# React calls this API. Vercel and Netlify both expose /api.
# In local dev, webpack proxies /api to CANVA_BACKEND_PORT.
APP_API_BASE_URL=/api
ALLOW_LOCAL_PREVIEW_FALLBACK=false
CANVA_BACKEND_PORT=3001

# Online Google Sheet used by the backend.
GOOGLE_SHEETS_SPREADSHEET_ID=1e1z1pfNArVzaZs5FE4k0e3JqIlwJIPG_aWH4Fziqnl8

# Use one of these Google service account options. Share the Sheet with the
# service account client_email so it can read/write.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Firebase Admin verifies frontend Firebase ID tokens.
# On Netlify, prefer FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY instead of the
# full JSON to stay under AWS Lambda compatibility env size limits.
FIREBASE_SERVICE_ACCOUNT_KEY_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web app config. These values are safe for browser apps.
# Netlify/Vercel should use the VITE_ names for the frontend build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local fallback names are also supported by webpack.config.ts.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional emergency owner bootstrap only. Normal roles live in Firestore users/{uid}.
FIREBASE_OWNER_EMAILS=
