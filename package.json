{
  "private": true,
  "name": "joy-corner-loyalty",
  "description": "Standalone Joy Corner Loyalty staff web app.",
  "main": "firebase-functions.cjs",
  "scripts": {
    "backend": "tsx ./server/googleSheetsBackend.ts",
    "build": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.config.ts --mode production && tsx ./scripts/write_standalone_html.ts",
    "deploy": "npm run deploy:firebase",
    "deploy:firebase": "npm run build && node ./scripts/firebase_deploy.cjs hosting,functions,firestore:rules",
    "deploy:firebase:functions": "node ./scripts/firebase_deploy.cjs functions",
    "deploy:firebase:hosting": "npm run build && node ./scripts/firebase_deploy.cjs hosting",
    "deploy:firebase:rules": "node ./scripts/firebase_deploy.cjs firestore:rules",
    "dev": "concurrently \"npm run backend\" \"npm run start\"",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "format": "prettier '**/*.{css,ts,tsx}' --no-config --write",
    "format:check": "prettier '**/*.{css,ts,tsx}' --no-config --check --ignore-path",
    "format:file": "prettier $1 --no-config --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "migrate:neon": "tsx ./scripts/apply_neon_migrations.ts",
    "check": "npm run lint:types && npm run lint && npm test && npm run build",
    "start": "webpack serve --config webpack.config.ts --mode development",
    "sync:staff": "tsx ./scripts/sync_firestore_staff.ts",
    "test": "jest --no-cache --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:update": "npm run test -- -u",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "dotenv": "^16.6.0",
    "express": "^4.22.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "googleapis": "^173.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pg": "^8.22.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ngrok/ngrok": "1.5.2",
    "@playwright/test": "^1.61.1",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.1",
    "@svgr/webpack": "8.1.0",
    "@testing-library/react": "16.3.0",
    "@types/debug": "4.1.12",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.17",
    "@types/node-fetch": "2.6.13",
    "@types/node-forge": "1.3.14",
    "@types/nodemon": "1.19.6",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "chalk": "4.1.2",
    "cli-table3": "0.6.5",
    "css-loader": "7.1.2",
    "css-modules-typescript-loader": "4.0.1",
    "cssnano": "7.1.1",
    "debug": "4.4.1",
    "esbuild-register": "3.6.0",
    "eslint": "^10.6.0",
    "express-basic-auth": "1.2.1",
    "jest": "30.2.0",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "30.2.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.0",
    "mini-css-extract-plugin": "2.9.4",
    "node-fetch": "3.3.2",
    "node-forge": "1.4.0",
    "nodemon": "3.0.1",
    "open": "8.4.2",
    "postcss-loader": "8.1.1",
    "prettier": "3.6.2",
    "react-refresh": "0.17.0",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.4.0",
    "tree-kill": "1.2.2",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "typescript": "5.9.2",
    "url-loader": "4.1.1",
    "webpack": "5.105.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.5",
    "yargs": "17.7.2"
  },
  "engines": {
    "node": "22.x"
  }
}
