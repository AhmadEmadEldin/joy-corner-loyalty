{
  "private": true,
  "name": "joy-corner-loyalty",
  "description": "Joy Corner ordering and loyalty app powered by Neon and Northflank.",
  "scripts": {
    "backend": "tsx ./server/api.ts",
    "build": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.config.ts --mode production && tsx ./scripts/write_standalone_html.ts",
    "dev": "npm run start",
    "dev:full": "concurrently \"npm run backend\" \"npm run start\"",
    "e2e": "playwright test --config=playwright.config.ts",
    "e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "format": "prettier '**/*.{css,ts,tsx}' --no-config --write",
    "format:check": "prettier '**/*.{css,ts,tsx}' --no-config --check --ignore-path",
    "format:file": "prettier $1 --no-config --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "migrate:neon": "tsx ./scripts/apply_neon_migrations.ts",
    "migrate:sheet-to-neon": "tsx ./scripts/import_google_sheet_to_neon.ts",
    "reconcile:end-day": "tsx ./scripts/reconcile_end_day.ts",
    "check": "npm run lint:types && npm run lint && npm test && npm run build",
    "start": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js serve --config webpack.config.ts --mode development",
    "start:production": "tsx ./server/api.ts",
    "sync:reporting": "tsx ./scripts/sync_neon_reporting.ts",
    "verify:api-workflow": "tsx ./scripts/verify_api_workflow.ts",
    "test": "jest --no-cache --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:update": "npm run test -- -u"
  },
  "dependencies": {
    "dotenv": "^16.6.0",
    "express": "^4.22.2",
    "googleapis": "^173.0.0",
    "pg": "^8.22.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "16.3.0",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.17",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "concurrently": "^9.2.4",
    "css-loader": "7.1.2",
    "esbuild-register": "3.6.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "3.6.2",
    "style-loader": "4.0.0",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.65.0",
    "webpack": "5.105.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "^5.2.6"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "websocket-driver": "0.7.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
