{
  "private": true,
  "name": "joy-corner-loyalty",
  "description": "Supabase-powered Joy Corner ordering and operations app.",
  "scripts": {
    "backend:legacy": "tsx ./server/googleSheetsBackend.ts",
    "build": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js --config webpack.config.ts --mode production && tsx ./scripts/write_standalone_html.ts",
    "deploy:firebase": "npm run build && node ./scripts/firebase_deploy.cjs hosting,functions,firestore:rules",
    "deploy:firebase:functions": "node ./scripts/firebase_deploy.cjs functions",
    "deploy:firebase:hosting": "npm run build && node ./scripts/firebase_deploy.cjs hosting",
    "deploy:firebase:rules": "node ./scripts/firebase_deploy.cjs firestore:rules",
    "dev": "npm run start",
    "dev:legacy": "concurrently \"npm run backend:legacy\" \"npm run start:legacy\"",
    "e2e": "playwright test --config=playwright.supabase.config.ts",
    "e2e:legacy": "playwright test",
    "e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "e2e:supabase": "playwright test --config=playwright.supabase.config.ts",
    "format": "prettier '**/*.{css,ts,tsx}' --no-config --write",
    "format:check": "prettier '**/*.{css,ts,tsx}' --no-config --check --ignore-path",
    "format:file": "prettier $1 --no-config --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "migrate:neon": "tsx ./scripts/apply_neon_migrations.ts",
    "migrate:supabase": "tsx ./scripts/migrate_to_supabase.ts",
    "seed:supabase-menu": "tsx ./scripts/seed_supabase_menu.ts",
    "supabase:link": "supabase link --project-ref ruurfhrjqfcydxbzpuqi",
    "supabase:lint": "supabase db lint --linked --level warning",
    "supabase:push": "supabase db push --linked",
    "supabase:test": "supabase test db",
    "check": "npm run lint:types && npm run lint && npm test && npm run build",
    "start": "node --max-old-space-size=4096 ./node_modules/webpack/bin/webpack.js serve --config webpack.config.ts --mode development",
    "start:legacy": "node ./scripts/start_legacy_frontend.cjs",
    "sync:staff": "tsx ./scripts/sync_firestore_staff.ts",
    "sync:reporting": "tsx ./scripts/sync_supabase_reporting.ts",
    "test": "jest --no-cache --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:update": "npm run test -- -u",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "concurrently": "^10.0.3",
    "dotenv": "^16.6.0",
    "exceljs": "4.4.0",
    "express": "^4.22.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "googleapis": "^173.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pg": "^8.22.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "16.3.0",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.17",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "css-loader": "7.1.2",
    "esbuild-register": "3.6.0",
    "eslint": "^10.6.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "prettier": "3.6.2",
    "style-loader": "4.0.0",
    "supabase": "2.109.1",
    "ts-jest": "29.4.1",
    "ts-loader": "9.5.4",
    "typescript": "5.9.2",
    "webpack": "5.105.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.5"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "websocket-driver": "0.7.5"
  }
}
