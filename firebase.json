{
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      ".git",
      ".env",
      ".env.*",
      ".vscode",
      "apps-script",
      "backend*.log",
      "dist",
      "frontend*.log",
      "node_modules",
      "public",
      "styles"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "/api",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
