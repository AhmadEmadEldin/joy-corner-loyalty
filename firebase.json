{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs22",
    "ignore": [
      ".git",
      ".firebase",
      ".env",
      ".env.*",
      "firebase-debug.log",
      "node_modules",
      "dist",
      "coverage"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
